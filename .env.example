# ============================================================
#  ENVIRONMENT VARIABLES - SIMTRACER BKK SMK BINA BHAKTI
#  Copy file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# === DATABASE (SUPABASE POSTGRESQL) ===
# Ambil dari Supabase Dashboard: Project Settings > Database > Connection String > URI
# 1. Mode Pooler (Disarankan jika koneksi IPv4):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# 2. Mode Direct:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# CATATAN: Jika password Supabase mengandung simbol khusus (@, #, %, $), ganti dengan huruf & angka saja di Database Settings.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# === NEXTAUTH ===
# Di localhost gunakan http://localhost:3000. Jika deploy di Vercel, ganti ke https://nama-domain-anda.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="smk-bina-bhakti-secret-key-2024-skripsi-tracer"

# === EMAIL / SMTP (Fitur Reset Password) ===
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# Masukkan alamat Gmail Anda:
SMTP_USER="email-anda@gmail.com"
# PENTING: Gunakan 16 digit Sandi Aplikasi (App Password) dari Google, BUKAN password akun Gmail biasa.
# Cara buat: myaccount.google.com > Keamanan > Verifikasi 2 Langkah aktif > cari "Sandi Aplikasi"
SMTP_PASS="xxxx xxxx xxxx xxxx"
